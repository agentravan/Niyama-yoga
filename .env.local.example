# ─────────────────────────────────────────────────────────────
# Niyama Yoga — environment variables
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin account (the only email allowed into /admin)
ADMIN_EMAIL=Chandrapratap.cp30@gmail.com
# Used once by `npm run create-admin`. Change the password after first login.
ADMIN_INITIAL_PASSWORD=

# Resend (https://resend.com) — free tier: 3,000 emails / month
RESEND_API_KEY=re_xxxxxxxxx
# Until you verify a domain in Resend, keep onboarding@resend.dev
# (it can only deliver to the email that owns the Resend account).
EMAIL_FROM="Niyama Yoga <onboarding@resend.dev>"
# Where lead / feedback / upgrade notifications go
ADMIN_NOTIFY_EMAIL=Chandrapratap.cp30@gmail.com

# Live video: "daily" (recommended) or "jitsi"
NEXT_PUBLIC_VIDEO_PROVIDER=daily
# Daily.co (https://dashboard.daily.co) — free tier: 10,000 participant-minutes / month
DAILY_API_KEY=
# Jitsi fallback. meet.jit.si limits embedded calls to 5 minutes; use your own
# Jitsi server or 8x8 JaaS (e.g. 8x8.vc/<your-app-id>) for real classes.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# Optional: payment link shown on the upgrade screen (Razorpay / Stripe / UPI page)
NEXT_PUBLIC_PAYMENT_LINK=

# Protects the daily trial-check cron job. Generate with: openssl rand -hex 32
CRON_SECRET=
